<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- ML Kit Barcode Scanning Dependencies -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links for pgeu-system check-in / scanning URLs.
                 autoVerify opens the app directly only when a matching
                 assetlinks.json is served from each host; otherwise the link
                 falls back to the web app in the browser. Hosts and path
                 patterns mirror the previous native scanner app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <!-- PostgreSQL Europe -->
                <data
                    android:host="www.postgresql.eu"
                    android:pathPattern="/events/.*/checkin/.*/"
                    android:scheme="https" />
                <data
                    android:host="www.postgresql.eu"
                    android:pathPattern="/events/.*/checkin/.*/f.*/"
                    android:scheme="https" />
                <data
                    android:host="www.postgresql.eu"
                    android:pathPattern="/events/sponsor/scanning/.*"
                    android:scheme="https" />

                <!-- PostgreSQL US -->
                <data
                    android:host="postgresql.us"
                    android:pathPattern="/events/.*/checkin/.*/"
                    android:scheme="https" />
                <data
                    android:host="postgresql.us"
                    android:pathPattern="/events/.*/checkin/.*/f.*/"
                    android:scheme="https" />
                <data
                    android:host="postgresql.us"
                    android:pathPattern="/events/sponsor/scanning/.*"
                    android:scheme="https" />

                <!-- Slonik Events Canada -->
                <data
                    android:host="www.pgevents.ca"
                    android:pathPattern="/events/.*/checkin/.*/"
                    android:scheme="https" />
                <data
                    android:host="www.pgevents.ca"
                    android:pathPattern="/events/.*/checkin/.*/f.*/"
                    android:scheme="https" />
                <data
                    android:host="www.pgevents.ca"
                    android:pathPattern="/events/sponsor/scanning/.*"
                    android:scheme="https" />

                <!-- PGDay.UK -->
                <data
                    android:host="pgday.uk"
                    android:pathPattern="/events/.*/checkin/.*/"
                    android:scheme="https" />
                <data
                    android:host="pgday.uk"
                    android:pathPattern="/events/.*/checkin/.*/f.*/"
                    android:scheme="https" />
                <data
                    android:host="pgday.uk"
                    android:pathPattern="/events/sponsor/scanning/.*"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera feature (required by barcode scanner) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
